# HealthSutra (SIH25049) - Environment Configuration

# Application
APP_NAME=HealthSutra
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173"]

# LLM Provider Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Embeddings & Vector Search
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
FAISS_INDEX_PATH=data/vector_store/healthsutra_faiss.index
CHUNKS_METADATA_PATH=data/vector_store/healthsutra_chunks.json
RELEVANCE_THRESHOLD=0.52

# Database Configuration (PostgreSQL with SQLite fallback)
DATABASE_URL=sqlite:///./data/healthsutra.db
# For PostgreSQL use: postgresql://postgres:postgres@localhost:5432/healthsutra

# Security & Admin
ADMIN_API_KEY=healthsutra_admin_secret_key
RATE_LIMIT_PER_MINUTE=60
